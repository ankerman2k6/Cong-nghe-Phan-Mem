@model List<Book> //Nhận một danh sách sách từ controller truyền sang

@{
    ViewData["Title"] = "Danh sách sách";
}

<h2 class="mb-4">Danh sách sách</h2>

<a asp-controller="Book" asp-action="Create" class="btn btn-primary mb-3">
    Thêm sách mới
</a>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>TÊN SÁCH</th>
            <th>GIÁ ($)</th>
            <th>HÀNH ĐỘNG</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model) //Duyệt qua từng cuốn sách trong danh sách sách được truyền từ controller
        {
            <tr>
                <td>@book.Id</td>
                <td><strong>@book.Name</strong></td>
                <td>@book.Price</td>
                <td>
                    <a asp-controller="Book" asp-action="Detail" asp-route-id="@book.Id" class="btn btn-primary btn-sm">
                        Xem chi tiết
                    </a>

                    <a asp-controller="Book" asp-action="Edit" asp-route-id="@book.Id" class="btn btn-primary btn-sm">
                        Sửa
                    </a>

                    <a asp-controller="Book" asp-action="Delete" asp-route-id="@book.Id" class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>