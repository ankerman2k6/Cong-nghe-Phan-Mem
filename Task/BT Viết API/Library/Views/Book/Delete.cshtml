@model Book

@{
    ViewData["Title"] = "Xóa sách";
}

<h2 class="mb-4 text-danger">Xác nhận xóa sách</h2>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <p>Bạn có chắc chắn muốn xóa cuốn sách sau?</p>

        <table class="table">
            <tr>
                <th>ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Tên sách</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>Giá</th>
                <td>@Model.Price VNĐ</td>
            </tr>
        </table>

        <form asp-controller="Book" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a asp-controller="Book" asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>